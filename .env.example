# ChallengeBox reaches every model through the Claude Code CLI, so this file
# holds no provider API key. Authenticate the CLI once with `claude login`,
# or give it a key here and it is passed through to the child process:
#
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1
#
# Only ANTHROPIC_*, AWS_* and CLAUDE_CODE_USE_* entries are forwarded.

# --- routing -----------------------------------------------------------
# CLAUDE_BIN=claude
# CLAUDE_CHEAP_MODEL=claude-haiku-4-5-20251001
# CLAUDE_NORMAL_MODEL=claude-sonnet-5
# CLAUDE_STRONG_MODEL=claude-opus-5
# CLAUDE_FALLBACK_MODEL=claude-sonnet-5

# --- transport ---------------------------------------------------------
# CLAUDE_CLI_TIMEOUT_S=120     # hard cap for one CLI call
# CLAUDE_CLI_MIN_CALL_S=20     # below this the stage skips the model
# CLAUDE_CLI_ATTEMPTS=2        # attempts per model before the next in the chain
# CLAUDE_CLI_SAFE_MODE=1       # ignore CLAUDE.md, skills, hooks, plugins, MCP
# CLAUDE_CLI_TOOLS=            # empty disables every built-in tool
# CLAUDE_CLI_CWD=              # empty means a private temp directory
# CLAUDE_REUSE_SESSION=1       # repair resumes the generation session

# --- spend guardrails (claude --max-budget-usd), 0 disables the flag ---
# CLAUDE_PLAN_BUDGET_USD=0.50
# CLAUDE_TESTGEN_BUDGET_USD=0.50
# CLAUDE_GENERATE_BUDGET_USD=2.00
# CLAUDE_REPAIR_BUDGET_USD=2.00
