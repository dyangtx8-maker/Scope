# ChallengeBox reaches every model through the Claude Code CLI, so this file
# holds no provider API key. Authenticate the CLI once with `claude login`,
# or give it a key here and it is passed through to the child process.
# Only ANTHROPIC_*, AWS_* and CLAUDE_CODE_USE_* entries are forwarded.
#
# Copy to .env and uncomment what you need. Comments may follow a value on
# the same line, but keeping them on their own line is easier to read.

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1

# --- routing -----------------------------------------------------------
# Full path to the binary if it is not on PATH (Windows: ...\npm\claude.cmd)
# CLAUDE_BIN=claude
# Every stage runs Opus by default. CLAUDE_FALLBACK_MODEL is the emergency rung
# a timeout falls to - set it equal to the others only if you want a timeout to
# go straight to the local skeleton.
# CLAUDE_CHEAP_MODEL=claude-opus-5
# CLAUDE_NORMAL_MODEL=claude-opus-5
# CLAUDE_STRONG_MODEL=claude-opus-5
# CLAUDE_FALLBACK_MODEL=claude-sonnet-5

# --- transport ---------------------------------------------------------
# Hard cap for one CLI call, in seconds
# CLAUDE_CLI_TIMEOUT_S=240
# Share of the remaining budget one attempt may spend while a fallback remains
# CLAUDE_CLI_FIRST_ATTEMPT_SHARE=0.6
# Below this much time left, a stage skips the model and takes its fallback
# CLAUDE_CLI_MIN_CALL_S=20
# Attempts per model before moving down the fallback chain
# CLAUDE_CLI_ATTEMPTS=2
# Ignore CLAUDE.md, skills, hooks, plugins and MCP servers
# CLAUDE_CLI_SAFE_MODE=1
# Empty disables every built-in tool
# CLAUDE_CLI_TOOLS=
# Working directory for the child CLI; empty means a private temp directory
# CLAUDE_CLI_CWD=
# Let repair resume the generation session
# CLAUDE_REUSE_SESSION=1
# Overlap test-writing with generation (0 = the old sequential edge)
# CLAUDE_PARALLEL_STAGES=1
# Ask a model for the plan (0 = local heuristic only, no plan call at all)
# CLAUDE_PLAN_LLM=1
# Append every CLI call - argv, both prompts, reply - to this file
# CLAUDE_PROMPT_LOG=prompts.log

# --- spend guardrails (claude --max-budget-usd), 0 drops the flag ------
# CLAUDE_PLAN_BUDGET_USD=0.50
# CLAUDE_TESTGEN_BUDGET_USD=0.50
# CLAUDE_GENERATE_BUDGET_USD=2.00
# CLAUDE_REPAIR_BUDGET_USD=2.00
